#!/bin/bash

set -ex

# Default shared volumes
shared_repo=/repos
shared_data=/data
shared_home=${HOME}
shared_misc=/misc
shared_opt=/opt
shared_display=:0


# Default values
tag="amd64"
version="ubuntu22"
cmd=""

# network type: macvlan_dhcp/macvlan_static/docker0/host
NETWORK_TYPE=macvlan_static
PARENT_IF="enp0s31f6"   # host eth name


NETWORK_NAME="macvlan_net"

# ========================
# 自动检测宿主机网络信息
# ========================
detect_network_info() {
    HOST_IP=$(ip -4 addr show "$PARENT_IF" | grep -oP '(?<=inet\s)\d+(\.\d+){3}/\d+')
    SUBNET=$(ipcalc -n "$HOST_IP" | grep Network | awk '{print $2}')
    GATEWAY=$(ip route | grep "default via" | awk '{print $3}')

    if [ -z "$SUBNET" ] || [ -z "$GATEWAY" ]; then
        echo "error: failed to detect subnet or gateway"
        exit 1
    fi

    IFS=/ read NET_ADDR PREFIX <<< "$SUBNET"
    IFS=. read a b c d <<< "$NET_ADDR"
    IP_RANGE="${a}.${b}.${c}.128/25"

    echo "Detected network:"
    echo "  Host IP : $HOST_IP"
    echo "  Subnet  : $SUBNET"
    echo "  Gateway : $GATEWAY"
    echo "  IP Range: $IP_RANGE"
}


create_macvlan_net() {
    if docker network ls | grep -q "$NETWORK_NAME"; then
        echo "network $NETWORK_NAME already exists"
        return
    fi

    if [ "$NETWORK_TYPE"x == "macvlan_static"x ] || [ "$NETWORK_TYPE"x == "macvlan_dhcp"x ]; then
        docker network create -d macvlan \
            --subnet="$SUBNET" \
            --gateway="$GATEWAY" \
            --ip-range="$IP_RANGE" \
            -o parent="$PARENT_IF" \
            "$NETWORK_NAME"
        echo "Created macvlan network: $NETWORK_NAME"
    fi
}

# === 在宿主机创建 macvlan0 接口（容器和宿主机能互通） ===
create_host_macvlan() {
    if ip link show macvlan0 >/dev/null 2>&1; then
        echo "macvlan0 already exists"
        return
    fi
    HOST_MACVLAN_IP="${NET_ADDR%.*}.254"
    ip link add macvlan0 link "$PARENT_IF" type macvlan mode bridge
    ip addr add "$HOST_MACVLAN_IP/$PREFIX" dev macvlan0
    ip link set macvlan0 up
    echo "Created host macvlan0 with IP: $HOST_MACVLAN_IP"
}


# ========================
# 根据网络类型配置参数
# ========================

detect_network_info


if [ "$NETWORK_TYPE"x == "macvlan_static"x ]; then
    create_macvlan_net
    create_host_macvlan
    CONTAINER_NETWORK="--network=$NETWORK_NAME"
    CONTAINER_IP="--ip=${a}.${b}.${c}.200"
    CONTAINER_MAC="--mac-address=02:42:c0:a8:0a:99"

elif [ "$NETWORK_TYPE"x == "macvlan_dhcp"x ]; then
    create_macvlan_net
    create_host_macvlan
    CONTAINER_NETWORK="--network=$NETWORK_NAME"
    CONTAINER_IP=""
    CONTAINER_MAC="--mac-address=02:42:c0:a8:0a:99"

elif [ "$NETWORK_TYPE"x == "bridge"x ]; then
    CONTAINER_NETWORK="--network=bridge"
    CONTAINER_IP=""
    CONTAINER_MAC=""

elif [ "$NETWORK_TYPE"x == "host"x ]; then
    CONTAINER_NETWORK="--network=host"
    CONTAINER_IP=""
    CONTAINER_MAC=""
fi


# Show help
show_help() {
    echo "Usage: $0 [-h|--help] [-t <tag>] [-v <vesion>] [-x <cmd>]"
    echo "  -t <tag>     : CPU architecture (default: amd64)"
    echo "  -v <version> : Linux distribution (default: ubuntu22)"
    echo "  -x <cmd>     : Command to run inside the container (default: interactive shell)"
    echo "  -h, --help   : Show this help message"
    exit 0
}

# Parse command-line arguments
while getopts ":t:v:x:h" opt; do
    case ${opt} in
        t )
            tag=$OPTARG
            ;;
        v )
            version=$OPTARG
            ;;
        x )
            cmd=$OPTARG
            ;;
        h )
            show_help
            ;;
        \? )
            echo "Invalid option: -$OPTARG" >&2
            show_help
            ;;
        : )
            echo "Invalid option: -$OPTARG requires an argument" >&2
            show_help
            ;;
    esac
done
shift $((OPTIND -1))

# Docker run command
docker run --rm \
    -it \
    --privileged \
    $CONTAINER_NETWORK \
    $CONTAINER_IP \
    $CONTAINER_MAC \
    -e DISPLAY="${shared_display}" \
    -e USER="$(id -un)" \
    -e HOME="${shared_home}" \
    -h "${version}" \
    -v /dev:/dev \
    -v /run/udev:/run/udev \
    -v /tmp/.X11-unix:/tmp/.X11-unix:rw \
    -v /etc/passwd:/etc/passwd:ro \
    -v /etc/group:/etc/group:ro \
    -v /etc/shadow:/etc/shadow:ro \
    -v /etc/sudoers.d:/etc/sudoers.d:ro \
    -v "${shared_repo}:${shared_repo}" \
    -v "${shared_data}:${shared_data}" \
    -v "${shared_home}:${shared_home}" \
    -v "${shared_misc}:${shared_misc}" \
    -v "${shared_opt}:${shared_opt}" \
    -w "$(pwd)" \
    "${version}:${tag}" ${cmd}
